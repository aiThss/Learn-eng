VITE_GEMINI_API_KEY=your_gemini_api_key_here
# Text-only tutor/feedback model. Gemini TTS is never called by the Android/PWA app.
VITE_GEMINI_MODEL=gemini-3.1-flash-lite
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
# Optional: show the Dev Local LAN pin outside `npm run dev`.
VITE_ENABLE_DEV_LOCAL_PIN=false
VITE_DEV_LOCAL_URL=http://192.168.1.163:5173
